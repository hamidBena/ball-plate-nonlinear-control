{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Serial Dashboard",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": [
        "-serial-port",
        "COM5",
        "-baud",
        "115200",
        "-addr",
        ":8080"
      ]
    }
  ]
}
